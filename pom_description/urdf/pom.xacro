<?xml version="1.0"?>
<robot name="pom" xmlns:xacro="http://www.ros.org/wiki/xacro">

   <xacro:macro name="pom" params="model mode prefix">

      <xacro:if value="${model == '4x4'}">
         <xacro:include
            filename="$(find romea_mobile_base_description)/urdf/base2FWSxxx.chassis.xacro" />
      </xacro:if>

      <xacro:if value="${model == 'basic'}">
         <xacro:include
            filename="$(find romea_mobile_base_description)/urdf/base2FWSxxx.chassis.xacro" />
      </xacro:if>

      <xacro:include filename="$(find pom_description)/urdf/visual/color.xacro" />
      <xacro:include filename="$(find pom_description)/urdf/visual/half_leg.xacro" />
      <xacro:include filename="$(find pom_description)/urdf/visual/chassis.xacro" />
      <xacro:include filename="$(find pom_description)/urdf/visual/wheels.xacro" />
      <xacro:include filename="$(find pom_description)/urdf/visual/arms.xacro" />

      <xacro:property name="conf" value="$(find pom_description)/config/pom_${model}.yaml" />
      <xacro:include filename="$(find pom_description)/urdf/pom_properties.xacro" />

      <xacro:chassis>
         <chassis_visuals>
           <xacro:chassis_visual />
         </chassis_visuals>
         <xacro:front_left_arm_visual />
         <xacro:front_right_arm_visual />
         <xacro:front_left_wheel_visual />
         <xacro:front_right_wheel_visual />
         <xacro:rear_left_wheel_visual />
         <xacro:rear_right_wheel_visual />
      </xacro:chassis>

      <xacro:if value="${mesh == True}">
         <xacro:half_leg side="left">
            <origin xyz="1.5 ${aabb_width / 2 - 0.32} -0.032" rpy="-1.6525 0 ${pi/2}" />
         </xacro:half_leg>
         <xacro:half_leg side="right">
            <origin xyz="1.5 ${-aabb_width / 2} -0.032" rpy="-1.6525 0 ${pi/2}" />
         </xacro:half_leg>
      </xacro:if>

      <xacro:pom_gazebo_material link="${prefix}${base_link}" />

   </xacro:macro>

</robot>