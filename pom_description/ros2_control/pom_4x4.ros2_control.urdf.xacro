<?xml version='1.0' encoding='utf-8'?>
<robot name="pom_4x4_ros2_control" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix" default="pom_" />
  <xacro:arg name="mode" default="simulation" />
  <xacro:arg name="base_name" default="base" />


  <xacro:include filename="$(find pom_description)/ros2_control/pom.ros2_control.xacro" />

  <xacro:pom_ros2_control
    model="4x4"
    mode="$(arg mode)"
    prefix="$(arg prefix)"
    base_name="$(arg base_name)" />

</robot>